generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  password         String
  role             String            @default("USER") // Может быть USER, OWNER, ADMIN
  phone            String? // Телефон для связи
  createdAt        DateTime          @default(now())

  properties       Property[] // Объекты во владении (для OWNER)
  bookings         Booking[] // Бронирования пользователя (для USER)
  reviews          Review[] // Оставленные отзывы
  favorites        Favorite[] // Избранные объекты
  messageTemplates MessageTemplate[] // Шаблоны автоматических сообщений (для OWNER)
  sentMessages     Message[]         @relation("SentMessages") // Отправленные сообщения в чатах
  receivedMessages Message[]         @relation("ReceivedMessages") // Полученные сообщения в чатах
}

model Property {
  id              Int        @id @default(autoincrement())
  title           String
  description     String?    @db.Text
  address         String
  pricePerDay     Int
  image           String     @default("https://images.imagesimages.org/placeholder.jpg")
  category        String     @default("Апартаменты") // Квартира, Дом, Апартаменты
  rooms           Int        @default(1)
  maxGuests       Int        @default(2)
  distanceToMetro String? // Например: "5 мин"
  latitude        Float?
  longitude       Float?
  amenities       String[] // Массив удобств (Wi-Fi, Парковка и т.д.)
  rules           String?    @db.Text // Правила (без животных, залог)
  depositAmount   Int        @default(0) // Сумма залога
  createdAt       DateTime   @default(now())

  ownerId         Int
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  bookings        Booking[]
  reviews         Review[]
  favoritedBy     Favorite[]
}

model Booking {
  id          Int       @id @default(autoincrement())
  startDate   DateTime
  endDate     DateTime
  totalPrice  Int
  guestsCount Int       @default(1)
  status      String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  guestName   String? // ФИО гостя (если отличается от профиля)
  guestPhone  String? // Телефон гостя
  createdAt   DateTime  @default(now())

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId  Int
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  messages    Message[] // Все сообщения (автоматические и ручные), привязанные к этой брони
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int // От 1 до 5
  comment    String   @db.Text
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt  DateTime @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId]) // Защита от дублей в избранном
}

// НОВАЯ МОДЕЛЬ: Шаблоны автоматических триггерных сообщений владельца
model MessageTemplate {
  id       Int     @id @default(autoincrement())
  trigger  String // Тип события: "AFTER_BOOKING", "BEFORE_CHECKIN", "AFTER_CHECKOUT"
  content  String  @db.Text // Текст шаблона
  isActive Boolean @default(true) // Включена ли автоотправка по этому триггеру

  ownerId  Int
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, trigger]) // У одного владельца может быть только один шаблон на конкретный триггер
}

// НОВАЯ МОДЕЛЬ: Сообщения в чате (история переписки и логи автоотправок)
model Message {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text // Текст сообщения
  isAuto     Boolean  @default(false) // true — отправлено роботом по шаблону, false — вручную в чате
  createdAt  DateTime @default(now())

  bookingId  Int
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}